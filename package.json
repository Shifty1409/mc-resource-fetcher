    "@vitejs/plugin-react": "^6.1.2",
    "app-builder-bin": "^4.2.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
